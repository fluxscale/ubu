<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required for the Mac App Store. Nothing else is needed: StoreKit talks to
	     the App Store through the system, and Accessibility is a user grant, not an entitlement. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
